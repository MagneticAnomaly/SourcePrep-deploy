{
  "name": "prep-vscode",
  "displayName": "SourcePrep — Local Code Context Engine",
  "description": "Local-first semantic code search, context assembly, and structural trace for AI workflows. No code upload. SourcePrep works with Copilot, Cursor, Windsurf via MCP.",
  "version": "0.1.0",
  "publisher": "magnetic-anomaly",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MagneticAnomaly/SourcePrep"
  },
  "bugs": {
    "url": "https://github.com/MagneticAnomaly/SourcePrep/issues"
  },
  "homepage": "https://sourceprep.io",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "code search",
    "context",
    "RAG",
    "MCP",
    "local-first",
    "semantic search",
    "prep"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "media/prep-icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prep",
          "title": "SourcePrep",
          "icon": "media/prep-sidebar.svg"
        }
      ]
    },
    "views": {
      "prep": [
        {
          "id": "prep.projects",
          "name": "Projects",
          "icon": "media/prep-sidebar.svg"
        },
        {
          "id": "prep.fileTree",
          "name": "File Tree",
          "icon": "media/prep-sidebar.svg"
        },
        {
          "id": "prep.indexStatus",
          "name": "Index Status",
          "icon": "media/prep-sidebar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "prep.search",
        "title": "Prep: Search",
        "icon": "$(search)"
      },
      {
        "command": "prep.assembleContext",
        "title": "Prep: Assemble Context",
        "icon": "$(file-code)"
      },
      {
        "command": "prep.buildIndex",
        "title": "Prep: Build Index",
        "icon": "$(database)"
      },
      {
        "command": "prep.addProject",
        "title": "Prep: Add Project",
        "icon": "$(add)"
      },
      {
        "command": "prep.removeProject",
        "title": "Prep: Remove Project",
        "icon": "$(trash)"
      },
      {
        "command": "prep.copyMCPConfig",
        "title": "Prep: Copy MCP Config",
        "icon": "$(clippy)"
      },
      {
        "command": "prep.openDashboard",
        "title": "Prep: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "prep.startDaemon",
        "title": "Prep: Start Daemon",
        "icon": "$(play)"
      },
      {
        "command": "prep.stopDaemon",
        "title": "Prep: Stop Daemon",
        "icon": "$(debug-stop)"
      },
      {
        "command": "prep.enterLicenseKey",
        "title": "Prep: Enter License Key",
        "icon": "$(key)"
      },
      {
        "command": "prep.deactivateLicense",
        "title": "Prep: Deactivate License",
        "icon": "$(key)"
      },
      {
        "command": "prep.startWatcher",
        "title": "Prep: Start Watcher",
        "icon": "$(eye)"
      },
      {
        "command": "prep.stopWatcher",
        "title": "Prep: Stop Watcher",
        "icon": "$(eye-closed)"
      },
      {
        "command": "prep.traceLookup",
        "title": "Prep: Trace Lookup",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "prep.refreshProjects",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "prep.refreshFileTree",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "prep.selectProject",
        "title": "Select Project"
      },
      {
        "command": "prep.rebuildProject",
        "title": "Rebuild Index",
        "icon": "$(sync)"
      },
      {
        "command": "prep.pinFile",
        "title": "Pin File",
        "icon": "$(pin)"
      },
      {
        "command": "prep.unpinFile",
        "title": "Unpin File",
        "icon": "$(pinned)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "prep.refreshProjects",
          "when": "view == prep.projects",
          "group": "navigation"
        },
        {
          "command": "prep.addProject",
          "when": "view == prep.projects",
          "group": "navigation"
        },
        {
          "command": "prep.refreshFileTree",
          "when": "view == prep.fileTree",
          "group": "navigation"
        },
        {
          "command": "prep.refreshIndexStatus",
          "when": "view == prep.indexStatus",
          "group": "navigation"
        },
        {
          "command": "prep.startWatcher",
          "when": "view == prep.indexStatus",
          "group": "inline"
        },
        {
          "command": "prep.stopWatcher",
          "when": "view == prep.indexStatus",
          "group": "inline"
        },
        {
          "command": "prep.openDashboard",
          "when": "view == prep.indexStatus",
          "group": "inline"
        }
      ],
      "view/item/context": [
        {
          "command": "prep.selectProject",
          "when": "view == prep.projects && viewItem == project",
          "group": "inline"
        },
        {
          "command": "prep.rebuildProject",
          "when": "view == prep.projects && viewItem == project",
          "group": "1_actions"
        },
        {
          "command": "prep.removeProject",
          "when": "view == prep.projects && viewItem == project",
          "group": "2_destructive"
        },
        {
          "command": "prep.copyMCPConfig",
          "when": "view == prep.projects && viewItem == project",
          "group": "1_actions"
        },
        {
          "command": "prep.pinFile",
          "when": "view == prep.fileTree && viewItem == file",
          "group": "inline"
        },
        {
          "command": "prep.unpinFile",
          "when": "view == prep.fileTree && viewItem == pinnedFile",
          "group": "inline"
        },
        {
          "command": "prep.startWatcher",
          "when": "view == prep.indexStatus && viewItem == watcher_disabled",
          "group": "inline"
        },
        {
          "command": "prep.stopWatcher",
          "when": "view == prep.indexStatus && viewItem == watcher_enabled",
          "group": "inline"
        },
        {
          "command": "prep.traceLookup",
          "when": "view == prep.indexStatus && viewItem == trace",
          "group": "inline"
        },
        {
          "command": "prep.buildIndex",
          "when": "view == prep.indexStatus && viewItem == stale",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "prep.search",
        "key": "ctrl+alt+s",
        "mac": "cmd+opt+s",
        "when": "editorTextFocus"
      },
      {
        "command": "prep.assembleContext",
        "key": "ctrl+alt+c",
        "mac": "cmd+opt+c"
      },
      {
        "command": "prep.buildIndex",
        "key": "ctrl+alt+b",
        "mac": "cmd+opt+b"
      },
      {
        "command": "prep.traceLookup",
        "key": "ctrl+alt+t",
        "mac": "cmd+opt+t"
      }
    ],
    "configuration": {
      "title": "SourcePrep",
      "properties": {
        "prep.daemon.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "SourcePrep daemon host address"
        },
        "prep.daemon.port": {
          "type": "number",
          "default": 8400,
          "description": "SourcePrep daemon port"
        },
        "prep.daemon.executable": {
          "type": "string",
          "default": "prep",
          "description": "Path to the SourcePrep executable (or command name if on PATH)"
        },
        "prep.daemon.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the SourcePrep daemon when the extension activates"
        },
        "prep.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show SourcePrep status in the status bar"
        },
        "prep.pollingInterval": {
          "type": "number",
          "default": 10000,
          "description": "Health check polling interval in milliseconds",
          "minimum": 2000,
          "maximum": 60000
        }
      }
    },
    "chatParticipants": [
      {
        "id": "prep.chat",
        "name": "prep",
        "fullName": "SourcePrep",
        "description": "Ask questions about your codebase using SourcePrep's semantic index.",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:webview && node esbuild.mjs",
    "build:webview": "cd webview-ui && npm install && npm run build",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "esbuild": "^0.19.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "@vscode/vsce": "^2.22.0"
  }
}
